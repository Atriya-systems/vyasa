{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Bundle",
  "type": "object",
  "required": [
    "bundle_id",
    "chapter_name",
    "items",
    "manifest"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "chapter_name": {
      "type": "string"
    },
    "items": {
      "type": "array"
    },
    "manifest": {
      "type": "object"
    }
  }
}