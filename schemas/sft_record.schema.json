{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFT Record",
  "type": "object",
  "required": [
    "messages",
    "metadata"
  ],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "record_id",
        "source_unit_id",
        "lane",
        "record_type",
        "quality_status",
        "train_allowed",
        "drafted_by"
      ],
      "additionalProperties": true
    }
  }
}