# ----------------------------------------------------------------------
# AspireACE ModelOps + ContentOps Factory — environment configuration
# ----------------------------------------------------------------------
# Copy this file to `.env` and edit the values to suit your machine.
# `.env` is gitignored. NEVER commit secrets.
#
# Sections are organized by phase. M1 ships Phase 1; later phases activate
# additional variables. Settings unused at your current phase can be left
# as-is.

# ======================================================================
# Phase 1 — Provider + model
# ======================================================================
# Choose ONE provider. 'lmstudio' is the local Qwen3-8B / Phi / Llama path.
# 'openai' is the OpenAI-compatible cloud API path (real OpenAI, Together,
# Fireworks, Groq, etc.).
PROVIDER=lmstudio

# --- LM Studio (local) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# --- OpenAI-compatible (cloud) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Model + generation settings ---
MODEL_NAME=qwen3-8b-instruct
TEMPERATURE=0.1
MAX_TOKENS=9000

# ======================================================================
# Phase 1 — Dataset metadata defaults
# ======================================================================
# These set the default chapter context when not overridden by CLI flags.
CLASS_LEVEL=11
SUBJECT=Physics
EXAM_TARGETS=JEE,NEET
SOURCE_TYPE=SME_OWNED

# ======================================================================
# Phase 1 — Per-lane record counts (how many records per source unit)
# ======================================================================
BASE_RECORDS_PER_UNIT=4
TUTOR_RECORDS_PER_UNIT=5
CONTENTGEN_RECORDS_PER_UNIT=5
APP_CARDS_PER_UNIT=2
DPP_RECORDS_PER_UNIT=3
RUBRIC_RECORDS_PER_UNIT=2
REVISION_RECORDS_PER_UNIT=3

# ======================================================================
# Phase 1 — Verification + export
# ======================================================================
EVAL_RATIO=0.10
RANDOM_SEED=42
ENABLE_LLM_JUDGE=false
MIN_CORE_SCORE=4
SIMILARITY_WARN_THRESHOLD=0.82

# ======================================================================
# Phase 1 — Agent mode
# ======================================================================
AGENT_MAX_RETRIES=2
HUMAN_IN_LOOP=false

# ======================================================================
# Phase 1 — Logging
# ======================================================================
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Set to a file path to log JSON-lines to disk instead of stderr.
# Leave empty for stderr-only logging.
LOG_FILE=

# ======================================================================
# Phase 1 — MLflow / DVC tracking (optional)
# ======================================================================
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT=aspireace-modelops-contentops

# ======================================================================
# Phase 1 — Review app authentication
# ======================================================================
# JSON object of reviewers. Each entry:
#   <username>: {
#     "password_sha256": "<sha256-of-password>",
#     "seniority":       "junior" | "senior" | "HOD",
#     "subjects":        ["Physics", "Chemistry", ...]
#   }
# Generate password hashes with:
#   python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
# If left empty, a single dev account "dev_reviewer" / "dev_only_password" is
# provisioned. NEVER use the dev fallback in production.
REVIEWER_USERS=

# ======================================================================
# Phase 2 — API server (activated when M2 ships)
# ======================================================================
# Bearer token for AspireACE BFF → factory API auth. Generate a random one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FACTORY_API_TOKEN=
FACTORY_API_HOST=0.0.0.0
FACTORY_API_PORT=8765

# SQLite catalog DB path (single-tenant). Phase 2 default.
CATALOG_DB_PATH=factory_catalog.sqlite

# ======================================================================
# Phase 3 — Training + serving (activated when M3 ships)
# ======================================================================
# Path to the base model (HuggingFace name or local path).
TRAINING_BASE_MODEL=Qwen/Qwen3-8B
# Path where LoRA adapters land after training.
TRAINING_OUTPUT_DIR=artifacts/adapters
# vLLM serving endpoint (when the trained tutor is served locally).
TUTOR_SERVING_URL=http://localhost:8000/v1
TUTOR_SERVING_MODEL=aspireace-tutor-v1

# ======================================================================
# Phase 4 — Multi-tenant (activated when M4 ships)
# ======================================================================
# Postgres catalog (replaces SQLite) for multi-tenant deployment.
POSTGRES_CATALOG_URL=
# Stripe / Razorpay key for billing integration.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
